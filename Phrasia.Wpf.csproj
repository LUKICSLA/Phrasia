<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Phrasia</RootNamespace>
    <!-- helper tools (e.g. tools/ResourcePacker) are separate projects, not part of the app -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**</DefaultItemExcludes>
    <AssemblyName>Phrasia</AssemblyName>
    <ApplicationIcon>Assets\phrasia.ico</ApplicationIcon>
    <Version>1.20.0</Version>
    <Product>Phrasia</Product>
    <Authors>Lukáš "LUKI" Maár</Authors>
    <Company>Lukáš "LUKI" Maár</Company>
    <Copyright>© 2026 Lukáš "LUKI" Maár</Copyright>
    <Description>Phrasia – passphrase generator and encrypted password vault</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\phrasia.ico" />
    <Resource Include="Assets\phrasia-96.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>



  <ItemGroup>
    <None Update="Wordlists\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="Resources\r_sk.bin" LogicalName="r_sk" />
    <EmbeddedResource Include="Resources\r_en.bin" LogicalName="r_en" />
    <EmbeddedResource Include="Resources\r_cs.bin" LogicalName="r_cs" />
    <None Update="Resources\LICENSES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- license texts shown in the About window, so they ship inside the single-file .exe -->
    <EmbeddedResource Include="LICENSE" LogicalName="Phrasia.LICENSE" />
    <EmbeddedResource Include="Resources\LICENSES.txt" LogicalName="Phrasia.THIRD-PARTY-NOTICES" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="UI\App.xaml" />
    <ApplicationDefinition Include="UI\App.xaml" />
  </ItemGroup>

</Project>
